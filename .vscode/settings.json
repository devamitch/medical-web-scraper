      "terminal.ansiBrightYellow": "#E8C87D",
      "terminal.ansiBrightBlue": "#7AC1CD",
      "terminal.ansiBrightMagenta": "#E28F50",
      "terminal.ansiBrightCyan": "#7AC1CD",
      "terminal.ansiBrightWhite": "#F7F5F3",

      "input.background": "#30302E",
      "input.border": "#3A3935",

      "dropdown.background": "#30302E",

      "button.background": "#DA7049",
      "button.foreground": "#1F1E1D",
      "button.hoverBackground": "#E28F50",

      "badge.background": "#DA7049",
      "badge.foreground": "#1F1E1D",

      "progressBar.background": "#DA7049",

      "scrollbarSlider.background": "#98949033",
      "scrollbarSlider.hoverBackground": "#98949055",
      "scrollbarSlider.activeBackground": "#98949077",

      "gitDecoration.modifiedResourceForeground": "#E8C87D",
      "gitDecoration.untrackedResourceForeground": "#ABC577",
      "gitDecoration.deletedResourceForeground": "#E8738A"
    }
  },

  // ------------------------------------------------------------
  // SYNTAX COLORS
  // ------------------------------------------------------------

  "editor.tokenColorCustomizations": {
    "[Monokai]": {
      "comments": "#989490",
      "strings": "#E8C87D",
      "numbers": "#E8738A",
      "keywords": "#DA7049",
      "functions": "#ABC577",
      "types": "#7AC1CD",
      "variables": "#F7F5F3",

      "textMateRules": [
        {
          "scope": "comment",
          "settings": {
            "foreground": "#989490",
            "fontStyle": "italic"
          }
        },
        {
          "scope": ["keyword", "storage", "storage.type", "keyword.operator"],
          "settings": {
            "foreground": "#DA7049"
          }
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language",
            "constant.character",
            "constant.other"
          ],
          "settings": {
            "foreground": "#E8738A"
          }
        },
        {
          "scope": ["string", "string.regexp"],
          "settings": {
            "foreground": "#E8C87D"
          }
        },
        {
          "scope": ["entity.name.function", "support.function", "meta.function-call"],
          "settings": {
            "foreground": "#ABC577"
          }
        },
        {
          "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
          "settings": {
            "foreground": "#7AC1CD",
            "fontStyle": "italic"
          }
        },
        {
          "scope": ["variable.parameter"],
          "settings": {
            "foreground": "#E28F50",
            "fontStyle": "italic"
          }
        },
        {
          "scope": ["entity.name.tag"],
          "settings": {
            "foreground": "#DA7049"
          }
        },
        {
          "scope": ["entity.other.attribute-name"],
          "settings": {
            "foreground": "#ABC577"
          }
        },
        {
          "scope": ["punctuation", "meta.brace"],
          "settings": {
            "foreground": "#BCB8B3"
          }
        }
      ]
    }
  }
}
